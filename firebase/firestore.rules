rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Apex: brokers collection
    match /brokers/{brokerId} {
      allow read, write: if request.auth != null;
    }

    // Apex: user-scoped subcollections
    match /user/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection=**}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Finance: top-level collections with userId field
    match /accounts/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /transactions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /categories/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /budgets/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /investments/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /recurringTemplates/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Finance: unified per-user transaction graph, mirrored by the Zelax backend (Admin SDK)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId; // allowed for profile updates
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId; // allowed for bookmarks
      }
    }

    // Finance: Gmail link status
    match /gmail_links/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Finance: Gmail OAuth tokens (access + refresh)
    match /gmail_credentials/{userId} {
      allow read, write: if false;
    }

    // Finance: global market-news feed (cluster docs written by the Zelax ETL via the Admin SDK)
    match /news/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
